#!/bin/sh
# Runs the example APK on a headless emulator and checks it draws, types, taps and scrolls.
#   crates/gpui_android/android/try        (after ./build)
# Waits until no tart VM and no other emulator runs (one VM slot on this Mac), boots AVD
# ${AVD:-gpui-android-34} on port 5592 with no window, installs, types into the field, taps the
# button twice, flings the list,
# and leaves screenshots and logcat in target/android-try/.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/../../.." && pwd)
SDK=${ANDROID_HOME:-/opt/homebrew/share/android-commandlinetools}
OUT=$ROOT/target/android-try
APK=$HERE/app/build/outputs/apk/debug/app-debug.apk
PKG=dev.gpui.android.hello
mkdir -p "$OUT"
while tart list 2>/dev/null | grep -q ' running$' || pgrep -f qemu-system >/dev/null; do
  echo "try: waiting for the VM slot: a tart VM or an emulator runs"
  sleep 30
done
"$SDK/emulator/emulator" -avd "${AVD:-gpui-android-34}" -port 5592 -no-window -no-audio -no-boot-anim -no-snapshot -gpu ${GPU:-swiftshader_indirect} </dev/null >"$OUT/emulator.log" 2>&1 &
emu=$!
trap 'kill $emu 2>/dev/null || true' EXIT
S="adb -s emulator-5592"
$S wait-for-device
until [ "$($S shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; do sleep 2; done
# Root, for debuggerd; and setup marked done, so no setup wizard or first-run app covers ours.
$S root >/dev/null; sleep 3; $S wait-for-device
$S shell settings put secure user_setup_complete 1
$S shell settings put global device_provisioned 1
$S install -r "$APK" >/dev/null
# TalkBack off, as a run before may have left it.
$S shell settings delete secure enabled_accessibility_services
$S shell settings put secure accessibility_enabled 0
$S logcat -c
$S shell am start -W -n "$PKG/.MainActivity" | tee "$OUT/start.txt"
sleep 5
$S exec-out screencap -p >"$OUT/1-start.png"
# Every thread's stack, Java and native, to see where a stall is.
$S shell debuggerd -b "$($S shell pidof "$PKG" | tr -d '\r')" >"$OUT/stacks.txt" 2>&1 || true
size=$($S shell wm size | sed 's/.*: //' | tr -d '\r'); w=${size%x*}; h=${size#*x}
# Where the field and the button draw on a 1080x2400 screen at 420 dpi, below the status bar, below the status bar, as fractions of its height.
$S shell input tap $((w / 2)) $((h * 16 / 100)); sleep 2
$S shell input text "hello%sandroid"; sleep 2
$S exec-out screencap -p >"$OUT/2-typed.png"
$S shell dumpsys input_method | grep -E "mInputShown|mShowRequested" | head -3 | tee "$OUT/ime.txt"
$S shell input keyevent KEYCODE_DEL; sleep 1
# Copy the field's text to the system clipboard and paste it back: "hello androihello androi".
$S shell input keycombination KEYCODE_CTRL_LEFT KEYCODE_C; sleep 1
$S shell input keycombination KEYCODE_CTRL_LEFT KEYCODE_V; sleep 2
$S exec-out screencap -p >"$OUT/2-pasted.png"
$S shell input tap $((w / 4)) $((h * 22 / 100)); sleep 1
$S shell input tap $((w / 4)) $((h * 22 / 100)); sleep 2
$S exec-out screencap -p >"$OUT/3-tapped.png"
$S exec-out screencap -p >"$OUT/2-tapped.png"
$S shell input swipe $((w / 2)) $((h * 80 / 100)) $((w / 2)) $((h * 30 / 100)) 300; sleep 3
$S exec-out screencap -p >"$OUT/4-scrolled.png"
# The accessibility tree as an accessibility service sees it (AccessKit's adapter), and whether the
# image has TalkBack.
$S shell uiautomator dump /sdcard/ui.xml >"$OUT/ui-dump.txt" 2>&1 && $S pull /sdcard/ui.xml "$OUT/ui.xml" >/dev/null || true
$S shell pm list packages | grep -i -E "talkback|accessibility" >"$OUT/talkback.txt" || true
# TalkBack: the first tap puts its focus box on the button it reads; each tap after, on the
# focused button, clicks it through AccessKit once (adb's taps are never TalkBack's double tap).
# The list scrolled away, so the button is back at the top first.
TB=com.google.android.marvin.talkback/com.google.android.marvin.talkback.TalkBackService
$S shell input swipe $((w / 2)) $((h * 30 / 100)) $((w / 2)) $((h * 80 / 100)) 300; sleep 2
$S shell settings put secure enabled_accessibility_services "$TB"
$S shell settings put secure accessibility_enabled 1; sleep 6
$S shell input tap $((w / 4)) $((h * 22 / 100)); sleep 3
$S exec-out screencap -p >"$OUT/5-talkback-focus.png"
$S shell input tap $((w / 4)) $((h * 22 / 100)); sleep 3
$S exec-out screencap -p >"$OUT/6-talkback-tap-again.png"
$S shell "input tap $((w / 4)) $((h * 22 / 100)) & sleep 0.08; input tap $((w / 4)) $((h * 22 / 100))"; sleep 3
$S exec-out screencap -p >"$OUT/7-talkback-clicked.png"
$S shell uiautomator dump /sdcard/ui-talkback.xml >/dev/null 2>&1 && $S pull /sdcard/ui-talkback.xml "$OUT/ui-talkback.xml" >/dev/null || true
$S shell settings delete secure enabled_accessibility_services
$S shell settings put secure accessibility_enabled 0
$S logcat -d >"$OUT/logcat.txt"
pid=$($S shell pidof "$PKG" | tr -d '\r')
echo "try: app pid ${pid:-none}; screenshots and logcat in $OUT"
grep -E "gpui|AndroidRuntime|FATAL|wgpu" "$OUT/logcat.txt" | tail -40
[ -n "$pid" ]
