#!/bin/sh
# Builds the example APK: libhello.so with cargo ndk, then the GameActivity app around it.
#   crates/gpui_android/android/build [--release]
# The APK lands in app/build/outputs/apk/<debug|release>/. Needs ANDROID_HOME and an NDK.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/../../.." && pwd)
SDK=${ANDROID_HOME:-/opt/homebrew/share/android-commandlinetools}
export ANDROID_HOME=$SDK
export ANDROID_NDK_HOME=${ANDROID_NDK_HOME:-$SDK/ndk/28.2.13676358}
# Any JDK 17 or later; Homebrew's openjdk@21 when none is set.
export JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home}
profile=debug
flag=""
[ "${1:-}" != --release ] || { profile=release; flag=--release; }
cd "$ROOT"
cargo ndk -t arm64-v8a --platform 26 build -p gpui_android --example hello --target-dir target/android $flag
mkdir -p "$HERE/jniLibs/arm64-v8a"
cp "target/android/aarch64-linux-android/$profile/examples/libhello.so" "$HERE/jniLibs/arm64-v8a/"
cp "$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/darwin-x86_64/sysroot/usr/lib/aarch64-linux-android/libc++_shared.so" "$HERE/jniLibs/arm64-v8a/"
cd "$HERE"
task=assembleDebug
[ "$profile" = debug ] || task=assembleRelease
./gradlew -q "$task"
echo "gpui_android: $(ls "$HERE"/app/build/outputs/apk/"$profile"/*.apk)"
